# ══════════════════════════════════════════════════════════════
# QNB-Admin (CRM) — .env de PRODUÇÃO
# Copiar para .env no servidor e preencher o que falta
# ══════════════════════════════════════════════════════════════

# ─── APLICAÇÃO ───────────────────────────────────────────────
APP_NAME="QNB Admin (CRM)"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://imobiliariaequipa.qnbangola.ao

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─── LOGS ────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── BASE DE DADOS (MySQL — MESMA da imobiliaria) ───────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_user
DB_PASSWORD="your_password"

# ─── SESSÕES ────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=imobiliariaequipa.qnbangola.ao
SESSION_SECURE_COOKIE=true

# ─── FILAS / CACHE ──────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── EMAIL (SMTP) ───────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mail.qnbangola.com
MAIL_PORT=465
MAIL_USERNAME="noreply@qnbangola.com"
MAIL_PASSWORD="your_password"
MAIL_ENCRYPTION=ssl
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="noreply@qnbangola.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── URLs CRUZADOS ──────────────────────────────────────────
FRONTEND_URL=https://imobiliaria.qnbangola.ao
ADMIN_URL=https://imobiliariaequipa.qnbangola.ao

# ─── FILA DESTA APP ─────────────────────────────────────────
DB_QUEUE=admin

# ─── REDIS (manter database como driver) ────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── AWS (não necessário) ──────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── VITE (não usado, Blade puro) ──────────────────────────
VITE_APP_NAME="${APP_NAME}"
